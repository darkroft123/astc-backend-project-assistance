meta {
  name: ApproveJustification
}

post {
  url: {{base_url}}
}

headers {
  Content-Type: application/json
}

body:graphql {
  query: "mutation ApproveJustification($justificationId: String!, $comment: String!) { ApproveJustification(justificationId: $justificationId, comment: $comment) { __typename } }"
}

body:graphql:vars {
  justificationId: "11111111-1111-1111-1111-111111111111"
  comment: "Approved from Bruno"
}
